# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Used by tools/provision_wifi.py to hand the bridge its credentials over the
# UART console, so the password never appears on a command line or in shell
# history. The bridge stores them in NVS, so this is a once-per-board job.
WIFI_SSID=
WIFI_PASSWORD=
